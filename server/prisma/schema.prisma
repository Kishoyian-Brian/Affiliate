generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  restricted
}

enum BotAccessStatus {
  unknown
  ok
  failed
}

enum CampaignType {
  subscribe
  referral
  affiliate
}

enum CampaignStatus {
  draft
  active
  paused
  ended
}

enum CompletionStatus {
  awaiting_verification
  verified_pending
  completed
  failed
  cancelled
}

enum VerificationMethod {
  telegram_membership
}

enum ReferralStatus {
  attributed
  verified
  invalid
}

enum LedgerEntryType {
  held
  released
  revoked
  withdrawal_reserve
  withdrawal_paid
  withdrawal_rejected
}

enum WithdrawalMethod {
  ton
  usdt
  telegram_stars
}

enum WithdrawalStatus {
  pending
  processing
  completed
  rejected
}

enum NotificationType {
  reward_held
  reward_released
  verification_failed
  withdrawal
  referral
  system
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model User {
  id             String     @id @default(cuid())
  telegramId     BigInt     @unique @map("telegram_id")
  username       String?
  displayName    String     @map("display_name")
  status         UserStatus @default(active)
  tonAddress     String?    @map("ton_address")
  tonNetwork     String?    @map("ton_network")
  tonPublicKey   String?    @map("ton_public_key")
  tonWalletApp   String?    @map("ton_wallet_app")
  tonConnectedAt DateTime?  @map("ton_connected_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  completions         Completion[]
  referralsMade       Referral[]     @relation("Referrer")
  referralsAsReferred Referral[]     @relation("Referred")
  ledgerEntries       LedgerEntry[]
  withdrawals         Withdrawal[]
  tonProofNonces      TonProofNonce[]
  notifications       Notification[]

  @@map("users")
}

model TonProofNonce {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload   String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("ton_proof_nonces")
}

model Channel {
  id             String          @id @default(cuid())
  username       String          @unique
  title          String
  telegramChatId BigInt?         @unique @map("telegram_chat_id")
  memberCount    Int             @default(0) @map("member_count")
  botAccess      BotAccessStatus @default(unknown) @map("bot_access")
  lastCheckedAt  DateTime?       @map("last_checked_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  campaigns Campaign[]

  @@map("channels")
}

model Campaign {
  id               String         @id @default(cuid())
  channelId        String         @map("channel_id")
  channel          Channel        @relation(fields: [channelId], references: [id])
  title            String
  shortDescription String         @map("short_description")
  description      String
  type             CampaignType
  sponsorName      String         @map("sponsor_name")
  rewardAmount     Decimal        @map("reward_amount") @db.Decimal(12, 2)
  rewardCurrency   String         @default("USD") @map("reward_currency")
  holdHours        Int            @map("hold_hours")
  slotsTotal       Int            @map("slots_total")
  referralTarget   Int?           @map("referral_target")
  affiliateUrl     String?        @map("affiliate_url")
  requirements     Json
  rules            String[]
  status           CampaignStatus @default(draft)
  startAt          DateTime       @map("start_at")
  endAt            DateTime       @map("end_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  completions Completion[]
  referrals   Referral[]

  @@index([status, startAt, endAt])
  @@map("campaigns")
}

model Completion {
  id                 String              @id @default(cuid())
  campaignId         String              @map("campaign_id")
  campaign           Campaign            @relation(fields: [campaignId], references: [id])
  userId             String              @map("user_id")
  user               User                @relation(fields: [userId], references: [id])
  status             CompletionStatus    @default(awaiting_verification)
  verificationMethod VerificationMethod? @map("verification_method")
  telegramStatusRaw  String?             @map("telegram_status_raw")
  verifiedAt         DateTime?           @map("verified_at")
  holdReleaseAt      DateTime?           @map("hold_release_at")
  rewardAmount       Decimal             @map("reward_amount") @db.Decimal(12, 2)
  rewardCurrency     String              @map("reward_currency")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  ledgerEntries LedgerEntry[]
  referral      Referral?

  @@unique([campaignId, userId])
  @@index([status, holdReleaseAt])
  @@map("completions")
}

model Referral {
  id                   String         @id @default(cuid())
  campaignId           String         @map("campaign_id")
  campaign             Campaign       @relation(fields: [campaignId], references: [id])
  referrerId           String         @map("referrer_id")
  referrer             User           @relation("Referrer", fields: [referrerId], references: [id])
  referredUserId       String         @map("referred_user_id")
  referredUser         User           @relation("Referred", fields: [referredUserId], references: [id])
  referredCompletionId String?        @unique @map("referred_completion_id")
  referredCompletion   Completion?    @relation(fields: [referredCompletionId], references: [id])
  status               ReferralStatus @default(attributed)
  verifiedAt           DateTime?      @map("verified_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@unique([campaignId, referredUserId])
  @@index([campaignId, referrerId, status])
  @@map("referrals")
}

model LedgerEntry {
  id           String          @id @default(cuid())
  userId       String          @map("user_id")
  user         User            @relation(fields: [userId], references: [id])
  type         LedgerEntryType
  amount       Decimal         @db.Decimal(12, 2)
  currency     String
  completionId String?         @map("completion_id")
  completion   Completion?     @relation(fields: [completionId], references: [id])
  withdrawalId String?         @map("withdrawal_id")
  withdrawal   Withdrawal?     @relation(fields: [withdrawalId], references: [id])
  createdAt    DateTime        @default(now()) @map("created_at")

  @@unique([completionId, type])
  @@unique([withdrawalId, type])
  @@index([userId, type])
  @@map("ledger_entries")
}

model Withdrawal {
  id          String           @id @default(cuid())
  userId      String           @map("user_id")
  user        User             @relation(fields: [userId], references: [id])
  amount      Decimal          @db.Decimal(12, 2)
  fee         Decimal          @db.Decimal(12, 2)
  currency    String
  method      WithdrawalMethod
  destination String
  status      WithdrawalStatus @default(pending)
  requestedAt DateTime         @default(now()) @map("requested_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  ledgerEntries LedgerEntry[]

  @@index([status, requestedAt])
  @@map("withdrawals")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  href      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, read])
  @@map("notifications")
}
